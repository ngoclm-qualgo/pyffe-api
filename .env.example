BASE_URL=https://qa-api.example.com
DP_BASE_URL=https://qa-dp.example.com
DEVICE_ID=
TEST_USER_EMAIL=
TEST_USER_EMAIL_READONLY=
AUTH_TEST_OTP=
HMAC_SECRET=
ENCRYPTION_KEY=
# Below are used for tests that trigger notifications (see specs/notification-push-postman-curl-guide.md).
# If ADMIN_BASE_URL/ADMIN_ACCESS_TOKEN/AUDIENCE_ID are not set, the admin campaign tests auto-skip.
ADMIN_BASE_URL=
ADMIN_ACCESS_TOKEN=
AUDIENCE_ID=
# FAMILY_ID/ACTOR_DEVICE_ID: NOT required — family + actor device are auto-provisioned per worker (see
# src/core/fixtures/family-provisioning.ts). Set both only to override, reusing an existing family instead of creating one.
FAMILY_ID=
ACTOR_DEVICE_ID=